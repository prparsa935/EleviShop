# Font Awesome Pro: track only what the app imports (css/all.css) plus the
# webfonts it references; the rest (~145MB of svgs/js/sprites) stays local-only.
src/assets/FontAwesome.Pro.6.5.2/*
!src/assets/FontAwesome.Pro.6.5.2/css/
!src/assets/FontAwesome.Pro.6.5.2/webfonts/
src/assets/FontAwesome.Pro.6.5.2/css/*
!src/assets/FontAwesome.Pro.6.5.2/css/all.css
src/assets/FontAwesome.Pro.6.5.2/webfonts/*
!src/assets/FontAwesome.Pro.6.5.2/webfonts/fa-brands-400.ttf
!src/assets/FontAwesome.Pro.6.5.2/webfonts/fa-brands-400.woff2
